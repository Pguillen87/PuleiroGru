# Provider para desenvolvimento: mock. Em QA/staging com geração real, use modal.
# "real" não é um valor aceito pelo código; o provider real é identificado como modal.
MASCOT_GENERATION_PROVIDER=mock

# Limites e acompanhamento do job.
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
JOB_POLL_INTERVAL_MS=900
JOB_TIMEOUT_MS=90000
MOCK_GENERATION_DELAY_MS=1800

# Kill switches: geração falha fechada quando ausente ou false.
REGISTRATION_ENABLED=true
MASTER_GENERATION_ENABLED=false
POSE_GENERATION_ENABLED=false
# Incubadora assíncrona. Mantém o fluxo legado ativo enquanto false.
INCUBATOR_FLOW_ENABLED=false
# O ranking automático e o encoder verificado vivem no Modal; ambos devem estar
# habilitados no ambiente publicado antes de aceitar geração real.
INCUBATOR_AUTO_RANKING_ENABLED=false

# Supabase Auth Web. A anon key pode ir ao cliente; service_role é somente servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Somente para validar envio real de recuperação em staging. Nunca versionar e-mail pessoal.
SUPABASE_RECOVERY_TEST_EMAIL=
ALLOW_DEV_TEST_IDENTITY=false

# BFF → Modal v2. Nunca use prefixo NEXT_PUBLIC.
MODAL_MASCOT_API_URL=
MODAL_BFF_JWT_SECRET=
MODAL_BFF_JWT_ISSUER=puleiro-bff
MODAL_BFF_JWT_AUDIENCE=gru-modal
MODAL_BFF_JWT_TTL_SECONDS=90
