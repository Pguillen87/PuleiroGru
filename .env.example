# Provider para desenvolvimento: mock ou modal.
MASCOT_GENERATION_PROVIDER=mock

# Limites e acompanhamento do job.
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_DIMENSION=4096
JOB_POLL_INTERVAL_MS=900
JOB_TIMEOUT_MS=90000
MOCK_GENERATION_DELAY_MS=1800

# Kill switches: geração falha fechada quando ausente ou false.
REGISTRATION_ENABLED=true
MASTER_GENERATION_ENABLED=false
POSE_GENERATION_ENABLED=false

# Browser → BFF. Credencial Admin somente no servidor ou Application Default Credentials.
FIREBASE_ADMIN_CREDENTIALS_JSON=
ALLOW_DEV_TEST_IDENTITY=false

# BFF → Modal v2. Nunca use prefixo NEXT_PUBLIC.
MODAL_MASCOT_API_URL=
MODAL_BFF_JWT_SECRET=
MODAL_BFF_JWT_ISSUER=puleiro-bff
MODAL_BFF_JWT_AUDIENCE=gru-modal
MODAL_BFF_JWT_TTL_SECONDS=90
