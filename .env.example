# Provider padrão para desenvolvimento e testes: mock ou modal.
MASCOT_GENERATION_PROVIDER=mock

# Limites e acompanhamento do job.
MAX_UPLOAD_SIZE_MB=10
JOB_POLL_INTERVAL_MS=900
JOB_TIMEOUT_MS=90000
MOCK_GENERATION_DELAY_MS=1800

# Somente no servidor. Nunca use prefixo NEXT_PUBLIC nestas credenciais.
MODAL_MASCOT_API_URL=
MODAL_MASCOT_API_TOKEN=
MODAL_MASCOT_APP_CHECK_TOKEN=
